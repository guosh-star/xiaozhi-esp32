#ifndef _BOARD_CONFIG_H_
#define _BOARD_CONFIG_H_

#include <driver/gpio.h>

// 音频采样率
#define AUDIO_INPUT_SAMPLE_RATE  16000
#define AUDIO_OUTPUT_SAMPLE_RATE 24000

// 使用 Simplex I2S 模式（INMP441 + MAX98357 各占一对 I2S 引脚）
#define AUDIO_I2S_METHOD_SIMPLEX

#ifdef AUDIO_I2S_METHOD_SIMPLEX

// INMP441 麦克风 (I2S)
#define AUDIO_I2S_MIC_GPIO_WS   GPIO_NUM_4
#define AUDIO_I2S_MIC_GPIO_SCK  GPIO_NUM_5
#define AUDIO_I2S_MIC_GPIO_DIN  GPIO_NUM_6

// MAX98357 功放 (I2S)
#define AUDIO_I2S_SPK_GPIO_DOUT GPIO_NUM_7
#define AUDIO_I2S_SPK_GPIO_BCLK GPIO_NUM_15
#define AUDIO_I2S_SPK_GPIO_LRCK GPIO_NUM_16

#else
#error "cuckoo-clock board requires simplex I2S mode"
#endif

// 按键 (复用 boot 按键和触摸按键)
#define BOOT_BUTTON_GPIO        GPIO_NUM_0      // BOOT按键
#define TOUCH_BUTTON_GPIO       GPIO_NUM_47     // GPIO触摸

// LED指示灯
#define BUILTIN_LED_GPIO        GPIO_NUM_48     // 单色LED

// OLED 屏幕 (I2C SSD1306 128x64)
#define DISPLAY_SDA_PIN         GPIO_NUM_41
#define DISPLAY_SCL_PIN         GPIO_NUM_42
#define DISPLAY_WIDTH           128
#define DISPLAY_HEIGHT          64
#define DISPLAY_MIRROR_X        true
#define DISPLAY_MIRROR_Y        true

// ============================================
// 布谷鸟钟专用引脚定义
// ============================================
// 引脚分配依据：ESP32-S3-DevKitC-1 引脚图
// 被占用不可用的引脚（N8R16: Octal PSRAM 占用 35,36,37）：
//   0 = Boot按键      4-7 = I2S音频       15-16 = I2S音频
//   17 = 水车电机      41-42 = OLED I2C
//   35-37 = Octal PSRAM（不可用）          47 = 触摸按键
//   48 = LED
// 空闲可用：3,8,9,10,11,21,33,34,40,43,45,46

// --- TB6612 驱动板 1 (控制 M1 舞蹈 + M2 小提琴旋转) ---
// DRV8833: IN1/IN2 → M1, IN3/IN4 → M2, 面包板友好排列
#define DRV8833_M1_IN1      GPIO_NUM_12    // M1 舞蹈 IN1
#define DRV8833_M1_IN2      GPIO_NUM_13    // M1 舞蹈 IN2
#define DRV8833_M2_IN3      GPIO_NUM_14    // M2 小提琴 IN3
#define DRV8833_M2_IN4      GPIO_NUM_18    // M2 小提琴 IN4

// --- TB6612 驱动板 2 (控制 M3 水车 + M4 大门) ---
#define TB6612_2_PWMA      GPIO_NUM_12    // PWM M3
#define TB6612_2_AIN1      GPIO_NUM_13    // 方向 M3
#define TB6612_2_AIN2      GPIO_NUM_14    // 方向 M3
#define TB6612_2_PWMB      GPIO_NUM_18    // PWM M4
#define TB6612_2_BIN1      GPIO_NUM_19    // 方向 M4
#define TB6612_2_BIN2      GPIO_NUM_20    // 方向 M4

// --- 鸟门电机 (独立 H桥驱动, 2脚方向控制, 无PWM) ---
#define BIRD_DOOR_DIR1     GPIO_NUM_1     // 方向1
#define BIRD_DOOR_DIR2     GPIO_NUM_2     // 方向2

// --- 小鸟跳跃电磁铁 (三极管驱动) ---
#define BIRD_JUMP_GPIO     GPIO_NUM_38    // 高电平脉冲 (FSPIWP, N8R16下可用)

// --- 水车电机 (单路开关, 无速度/方向控制) ---
#define WATER_WHEEL_GPIO   GPIO_NUM_17    // 水车 (HIGH=转, LOW=停)

// --- 舵机信号线 (50Hz PWM) ---
#define SERVO_VIOLIN       GPIO_NUM_39    // 小提琴手舵机
#define SERVO_DOG          GPIO_NUM_44    // 小狗摇头舵机

// --- RTC模块 PCF8563 (I2C, 地址0x51) ---
// 和 OLED 共享 I2C0 总线(SDA=41, SCL=42)，无需额外引脚

// --- 光敏电阻 (昼夜检测) ---
// ⚠️ GPIO37 = Octal PSRAM SPIDQS (N8R16), 不能作 GPIO
// 当前未接线，定义保留以备将来换 N8R8 板子使用
#define LDR_GPIO           GPIO_NUM_37    // 数字输入 (N8R16不可用)

// --- LEDC PWM 通道分配 (ESP32-S3: 8通道, LEDC_CHANNEL_0~7) ---
// 定时器分配: TIMER_0=电机(Motor), TIMER_1=舵机(Servo)
// DRV8833: 每路电机占2个LEDC通道 (AIN1+AIN2)
#define LEDC_CH_M1_AIN1    LEDC_CHANNEL_0   // DRV8833: M1 舞蹈电机 AIN1
#define LEDC_CH_M1_AIN2    LEDC_CHANNEL_1   // DRV8833: M1 舞蹈电机 AIN2
#define LEDC_CH_M2_AIN1    LEDC_CHANNEL_2   // DRV8833: M2 小提琴电机 AIN1
#define LEDC_CH_M2_AIN2    LEDC_CHANNEL_3   // DRV8833: M2 小提琴电机 AIN2
#define LEDC_CH_SERVO_V    LEDC_CHANNEL_4   // 小提琴手舵机
#define LEDC_CH_SERVO_D    LEDC_CHANNEL_5   // 小狗舵机

// ============================================
// 在线音乐代理默认地址
// 启动后可通过 cuckoo.set_music_proxy MCP 工具修改
// ============================================
#define DEFAULT_MUSIC_PROXY_HOST    "192.168.31.18"  // 改成你的电脑IP
#define DEFAULT_MUSIC_PROXY_PORT    8765

#endif // _BOARD_CONFIG_H_
